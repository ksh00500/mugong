{
  "name": "mugong",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:assets && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-runtime-assets.mjs",
    "assets:catalog": "node scripts/asset-bundles.mjs catalog",
    "assets:verify": "node scripts/asset-bundles.mjs verify runtime",
    "assets:pack": "node scripts/asset-bundles.mjs pack",
    "test:hosting": "playwright test --config playwright.hosting.config.ts",
    "test": "vitest run",
    "test:source": "node scripts/test-source.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src tests *.ts *.json index.html"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "agent-browser": "^0.27.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
