* text=auto eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Public media uses ordinary Git; authoring media remains external. No LFS filters.
public/**/*.png binary
public/**/*.webp binary
public/**/*.jpg binary
public/**/*.jpeg binary
public/**/*.wav binary
public/**/*.webm binary
public/**/*.woff2 binary

# Provenance manifests may hash prompt/source bytes; preserve their original endings.
docs/source/** -text
assets/** -text
# Exact image-generation inputs include intentional end-of-line spaces.
docs/source/tomb-bamboo-special-v2/generated/*.used-prompt.txt whitespace=-blank-at-eol
