# Default: accessible only on the server itself, behind your existing HTTPS proxy.
MUGONG_BIND=127.0.0.1
MUGONG_PORT=8080
MUGONG_TAG=local
# Exact browser origin, with no trailing slash. Required for Cloudflare hosting.
# Use only the public HTTPS origin in production so the session cookie is Secure.
MUGONG_PUBLIC_ORIGIN=http://127.0.0.1:8080
